  "cards": [
    {
      "dot": "cyan",
      "title": "Request path and gates",
      "items": [
        "Mobile and panel hit one Laravel 13 app; public reads are open under /api/v1",
        "Authenticated group runs auth:sanctum, then status, legal.acceptance, profile.completed, role",
        "Idempotency, access-log and throttle middleware run before controllers",
        "Admin prefix is dynamic via GameSetting; role:admin,super_admin,moderator guards the panel"
      ]
    },
    {
      "dot": "emerald",
      "title": "Report lifecycle",
      "items": [
        "store() forces status pending, validates media, adds a moderation_queues row, dispatches AnalyzeReport",
        "ReportAnalysisService writes approved, rejected or pending plus authenticity_score and ai_analysis",
        "AdminController approveReport or rejectReport records verified_by, XP changes and an audit log",
        "Approved reports publish a proximity Alert and a queued nearby push"
      ]
    },
    {
      "dot": "violet",
      "title": "AI, queue and data",
      "items": [
        "Text chain order: Groq, Gemini per key, Cloudflare Workers AI; vision: Gemini, Cloudflare",
        "Rate-limited keys block in Redis-backed cache and the chain fails over or throws",
        "Queue default driver is database jobs table; scheduler runs BIPAD sync, weather and AI commands",
        "Redis holds bbox and directions caches, assistant quota, OSM import state and the live feed"
      ]
    },
    {
      "dot": "amber",
      "title": "Monetization and trust edges",
      "items": [
        "Ads are first-party campaigns: impression and click tracking feeds FraudDetectionService then CoinService into the coin wallet ledger",
        "Support chat starts AI-handled and moves to awaiting_human with takeover, stop-AI and CSAT",
        "Legal documents are authored in the panel; acceptances gate writes until re-accepted",
        "External: BIPAD, Open-Meteo, Overpass, OSRM, Groq, Gemini, Cloudflare, FCM, SMS, eSewa, Khalti"
      ]
    }
  ]
